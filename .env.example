# Documentation only: scripts do not automatically load this file.
# Inject settings through the environment or use node --env-file=/secure/path.
NEXUS_AI_ENABLED=false
NEXUS_DB_PATH=.cache/nexus.sqlite
NEXUS_APP_ORIGIN=http://127.0.0.1:5173
PORT=3001
# Required only when enabling live platform AI; supply the key securely server-side.
# NEXUS_AI_API_KEY=<set through environment secrets, never commit>
# NEXUS_AI_ENDPOINT=https://api.openai.com/v1/chat/completions
# NEXUS_AI_MODEL=<provider-approved model identifier>
# Prices in micro USD per million tokens; 1 USD = 1,000,000 micro USD.
# Verify current provider prices; no pricing assumptions are built in.
# NEXUS_AI_INPUT_MICROUSD_PER_MILLION=<positive integer>
# NEXUS_AI_OUTPUT_MICROUSD_PER_MILLION=<positive integer>
NEXUS_AI_REQUESTS_PER_MINUTE=5
NEXUS_AI_DAILY_TOKENS=20000
NEXUS_AI_USER_MONTHLY_MICROUSD=1000000
NEXUS_AI_GLOBAL_MONTHLY_MICROUSD=5000000
NEXUS_AI_CONCURRENCY=2
